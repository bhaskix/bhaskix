#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Refuses a commit message that carries an AI-vendor attribution, or any
# co-authorship or generated-by trailer.
#
# **The message is checked separately from the content, and it has to be.**
# pre-commit sees the staged files; it never sees the message, because the
# message does not exist yet when it runs. A trailer is precisely the leak this
# project is guarding against -- it is added automatically, at commit time, by
# tooling that means well -- so it needs its own hook at the only moment it can
# be caught.
#
# Two classes are refused:
#
#   1. A vendor name anywhere in the message (tools/vendor-pattern.sh).
#   2. An attribution *trailer*, whoever it names. This is the tighter of the
#      two: it catches the shape rather than guessing the vocabulary, so a
#      model name that is an ordinary English word -- and therefore
#      deliberately absent from the pattern -- is caught here anyway.
#
# docs/coding-style.md §9 asks for exactly one trailer family: `Signed-off-by:`
# for the DCO, plus `Fixes:`. Co-authorship is not part of this project's
# convention, so refusing it costs nothing that the convention allows.

set -uo pipefail

MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=../vendor-pattern.sh
. "$REPO_ROOT/tools/vendor-pattern.sh"

# Comment lines are stripped: `git commit` puts the whole diff under a
# scissors line in verbose mode, and judging a message by the diff it quotes
# would refuse a commit that legitimately *fixes* an offending file.
body="$(grep -v '^#' "$MSG_FILE")"

fail=0

if printf '%s' "$body" | grep -qiE "$VENDOR_PATTERN"; then
    printf '\033[1;31mFAIL\033[0m  AI-vendor attribution in the commit message -- commit refused\n' >&2
    printf '%s' "$body" | grep -inE "$VENDOR_PATTERN" | head -5 | sed 's/^/        /' >&2
    fail=1
fi

# `Co-Authored-By` and `Generated with` are the two shapes assistant tooling
# adds by default. Anchored to the start of a line so prose that merely
# discusses a trailer is not refused.
TRAILER='^[[:space:]]*(co-authored-by:|generated with|assisted-by:|on-behalf-of:)'
if printf '%s' "$body" | grep -qiE "$TRAILER"; then
    printf '\033[1;31mFAIL\033[0m  attribution trailer in the commit message -- commit refused\n' >&2
    printf '%s' "$body" | grep -inE "$TRAILER" | head -5 | sed 's/^/        /' >&2
    fail=1
fi

if (( fail )); then
    cat >&2 <<'EOF'

        This project's commit convention is docs/coding-style.md §9:
        `Signed-off-by:` for the DCO, and `Fixes:` where one applies. No
        co-authorship or generated-by trailers.

        A commit message cannot be edited after a public push. Rewrite the
        message and commit again.
EOF
    exit 1
fi

exit 0
