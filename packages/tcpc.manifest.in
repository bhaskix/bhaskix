# The TCP demonstration client and instrument: a badged endpoint to
# the service, its report page, twelve 4-page stream rings it owns and
# gifts across the handover -- four for its demonstration, six more
# for three ring pairs it arms its listener with (RFC 0086 step 2), and
# two for a second listener it opens on port 8 (step 3a) --
# and the two wakes it stops spinning on.
package tcpc
version 0.1.0

program bin/tcpc
entry hertz
cap endpoint tcp
cap memory pages=1
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap memory pages=4
cap notification
cap notification

payload bin/tcpc from user/tcpc/target/x86_64-unknown-none/release/tcpc
